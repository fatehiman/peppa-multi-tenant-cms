# /etc/systemd/system/hostkit.service
# Edit the ExecStart flags (-listen, -panel-host, -fallback-html) for your server.
[Unit]
Description=hostkit multi-tenant website engine
After=network.target

[Service]
Type=simple
User=hostkit
Group=hostkit
WorkingDirectory=/srv/hostkit
Environment=GOMEMLIMIT=40MiB
ExecStart=/srv/hostkit/hostkit -root /srv/hostkit -listen 127.0.0.1:8080 -panel-host panel.example.com serve
# `systemctl reload hostkit` re-parses themes, reloads sites, clears the page cache
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=2
MemoryMax=80M
UMask=0022
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
ReadWritePaths=/srv/hostkit /srv/backups

[Install]
WantedBy=multi-user.target
