# Nginx in front of hostkit: one catch-all server, static files served directly.
# Certificates: certbot --nginx -d example.com -d www.example.com (one per site).

server {
    listen 80 default_server;
    listen 443 ssl default_server;
    server_name _;
    # ssl_certificate / ssl_certificate_key: added by certbot per domain

    client_max_body_size 32m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Frame-Options SAMEORIGIN always;

    # theme assets: /_t/<theme>/... → themes/<theme>/assets/...
    location ~ ^/_t/([a-z0-9][a-z0-9-]*)/(.+)$ {
        alias /srv/hostkit/themes/$1/assets/$2;
        expires 1y;
        access_log off;
    }

    # uploads: /_m/<site>/... → sites/<site>/uploads/... (never site.db)
    location ~ ^/_m/([a-z0-9][a-z0-9-]*)/([^/]+)$ {
        alias /srv/hostkit/sites/$1/uploads/$2;
        add_header X-Content-Type-Options nosniff always;
        expires 30d;
        access_log off;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
